{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "romp-cloud",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "REPOSITORIES": "[]",
    "CONCURRENCY": "1",
    "GITHUB_APP_ID": "",
    "OPENAI_AUTH": "api-key",
  },
  "durable_objects": {
    "bindings": [
      { "name": "AUTH", "class_name": "SubscriptionAuth" },
      {
        "name": "SCHEDULER",
        "class_name": "Scheduler",
      },
      {
        "name": "RUNS",
        "class_name": "IssueRun",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Scheduler", "IssueRun"],
    },
    { "tag": "v2", "new_sqlite_classes": ["SubscriptionAuth"] },
  ],
  "containers": [
    {
      "class_name": "IssueRun",
      "scheduling_policy": "durable_object",
      "images": {
        "runner": {
          "dockerfile": "./Dockerfile",
        },
      },
    },
  ],
  "secrets": {
    "required": ["GITHUB_WEBHOOK_SECRET", "GITHUB_PRIVATE_KEY", "ADMIN_TOKEN"],
  },
}
