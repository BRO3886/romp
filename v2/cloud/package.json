{
  "name": "@romp/cloud",
  "version": "2.0.0-experimental.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.cli.json",
    "test:setup": "node --import tsx --test test/setup.node.ts",
    "types": "wrangler types --include-runtime false",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "preflight": "node --import tsx scripts/preflight.ts",
    "bundle": "wrangler deploy --dry-run --outdir .build",
    "lint": "eslint src test scripts",
    "format": "prettier --write src test scripts *.json *.jsonc *.ts *.mjs *.md",
    "format:check": "prettier --check src test scripts *.json *.jsonc *.ts *.mjs *.md",
    "test:container": "node --import tsx scripts/container-check.ts",
    "test:preflight": "node --import tsx --test test/preflight.node.ts"
  },
  "dependencies": {
    "@commander-js/extra-typings": "15.0.0",
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "@napi-rs/keyring": "2.1.1",
    "commander": "15.0.0",
    "typebox": "1.3.27",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.2",
    "@cloudflare/workers-types": "5.20261014.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11",
    "wrangler": "4.151.0",
    "vite": "7.3.7",
    "msw": "2.15.0",
    "@msw/cloudflare": "0.1.0"
  }
}
